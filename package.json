{
  "name": "emonor",
  "version": "0.1.0",
  "type": "module",
  "description": "Emoji-tagged personal GIF library with one-click copy",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennougorilla/Emonor"
  },
  "homepage": "https://dennougorilla.github.io/Emonor/",
  "license": "MIT",
  "keywords": ["gif", "emoji", "organizer", "pwa", "vanilla-typescript"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
